tech:
  frontend: "Laravel Blade templates dengan JavaScript seperlunya untuk interaksi UI."
  backend: "Laravel 11, PHP, modular monolith dengan controller tipis, Form Request validation, Policies, Actions atau Services, Events, dan Jobs bila dibutuhkan."
  database: "MySQL dengan foreign keys, unique constraints, indeks yang sesuai, dan transaksi database untuk operasi kritis."
  styling: "Tailwind CSS dengan reusable Blade components dan design tokens."
  authentication: "Laravel authentication dengan session, password hashing, email verification, reset password, dan middleware authorization."
  hosting: "Belum ditentukan. Siapkan konfigurasi environment untuk staging dan production, HTTPS, queue worker jika digunakan, scheduled tasks, dan backup database."
  integrations:
    - "Email provider untuk verifikasi dan reset password; provider ditentukan kemudian."
    - "Object storage untuk file jika upload dokumen diaktifkan pada tahap berikutnya."
    - "Payment gateway untuk subscription pada tahap lanjutan; provider belum ditentukan."
  architecture:
    - "Gunakan modular monolith, bukan microservices untuk MVP."
    - "Pisahkan domain Purchase Requests, Approvals, Purchase Orders, Suppliers, Budgets, Organization, dan Audit."
    - "Jangan menaruh seluruh business logic di controller atau Blade."
    - "Gunakan service/action yang dapat diuji untuk perubahan status dan keputusan approval."
    - "Semua perubahan status penting dijalankan melalui transisi yang tervalidasi."
  implementation_note: "Laravel 11 adalah versi yang diminta. Sebelum deployment production, verifikasi dukungan keamanan framework dan PHP yang dipilih; bila Laravel 11 tidak lagi mendapat security fixes, ajukan peningkatan versi sebagai keputusan teknis sebelum peluncuran."

data:
  entities:
    - name: "Organization"
      fields: ["id", "name", "slug", "status", "timezone", "created_at", "updated_at"]
      relationships: ["has many memberships", "has many departments", "has many cost_centers", "has many suppliers", "has many purchase_requests", "has many purchase_orders"]

    - name: "User"
      fields: ["id", "name", "email", "password", "email_verified_at", "status", "created_at", "updated_at"]
      relationships: ["belongs to many organizations through memberships", "may create purchase_requests", "may perform approval actions"]

    - name: "Membership"
      fields: ["id", "organization_id", "user_id", "role", "status", "invited_by", "joined_at"]
      relationships: ["belongs to organization", "belongs to user"]
      constraints: ["unique organization_id + user_id"]

    - name: "Department"
      fields: ["id", "organization_id", "name", "code", "manager_user_id", "status"]
      relationships: ["belongs to organization", "has many purchase_requests"]

    - name: "CostCenter"
      fields: ["id", "organization_id", "name", "code", "budget_id", "status"]
      relationships: ["belongs to organization", "may be referenced by purchase_requests and purchase_orders"]

    - name: "Supplier"
      fields: ["id", "organization_id", "code", "name", "email", "phone", "address", "status"]
      relationships: ["belongs to organization", "has many purchase_orders"]

    - name: "CatalogItem"
      fields: ["id", "organization_id", "sku", "name", "description", "unit", "default_price", "currency", "status"]
      relationships: ["belongs to organization", "may be referenced by purchase_request_items and purchase_order_items"]

    - name: "PurchaseRequest"
      fields: ["id", "organization_id", "request_number", "requester_id", "department_id", "cost_center_id", "purpose", "needed_by", "currency", "estimated_total", "status", "submitted_at", "created_at", "updated_at"]
      relationships: ["belongs to organization", "belongs to requester", "has many purchase_request_items", "has many approval_instances", "may generate purchase_orders"]

    - name: "PurchaseRequestItem"
      fields: ["id", "purchase_request_id", "catalog_item_id", "description", "quantity", "unit", "estimated_unit_price", "line_total"]
      relationships: ["belongs to purchase_request", "optionally belongs to catalog_item"]

    - name: "ApprovalWorkflow"
      fields: ["id", "organization_id", "name", "document_type", "priority", "conditions_json", "status", "version"]
      relationships: ["belongs to organization", "has many approval_steps"]
      constraints: ["workflow configuration changes must be validated and versioned"]

    - name: "ApprovalStep"
      fields: ["id", "approval_workflow_id", "step_order", "approver_role", "approver_user_id", "department_condition", "minimum_amount", "maximum_amount", "is_required"]
      relationships: ["belongs to approval_workflow", "may assign approval_instances"]

    - name: "ApprovalInstance"
      fields: ["id", "organization_id", "document_type", "document_id", "workflow_version", "step_order", "approver_user_id", "status", "decision_at", "decision_reason"]
      relationships: ["belongs to organization", "references a document and approval step"]
      constraints: ["approval decision must be recorded with actor, timestamp, and applicable workflow version"]

    - name: "PurchaseOrder"
      fields: ["id", "organization_id", "po_number", "purchase_request_id", "supplier_id", "created_by", "order_date", "expected_delivery_date", "currency", "subtotal", "tax_total", "grand_total", "status", "issued_at"]
      relationships: ["belongs to organization", "belongs to supplier", "may belong to purchase_request", "has many purchase_order_items", "has many approval_instances"]

    - name: "PurchaseOrderItem"
      fields: ["id", "purchase_order_id", "catalog_item_id", "description", "quantity", "unit", "unit_price", "line_total"]
      relationships: ["belongs to purchase_order", "optionally belongs to catalog_item"]

    - name: "Budget"
      fields: ["id", "organization_id", "name", "department_id", "cost_center_id", "period_start", "period_end", "allocated_amount", "currency", "status"]
      relationships: ["belongs to organization", "may apply to department or cost_center"]

    - name: "AuditLog"
      fields: ["id", "organization_id", "actor_user_id", "action", "entity_type", "entity_id", "before_json", "after_json", "reason", "ip_address", "created_at"]
      relationships: ["belongs to organization", "references actor"]
      constraints: ["append-only through application policy; no normal edit or delete operation"]

    - name: "Notification"
      fields: ["id", "organization_id", "user_id", "type", "title", "body", "read_at", "created_at"]
      relationships: ["belongs to organization", "belongs to user"]

    - name: "Subscription"
      fields: ["id", "organization_id", "plan_code", "billing_period", "status", "starts_at", "ends_at"]
      relationships: ["belongs to organization"]
      notes: "Schema dan billing automation dapat diaktifkan pada fase subscription; aturan paket belum ditentukan."

design:
  style: "Modern B2B SaaS, profesional, bersih, berorientasi produktivitas, enterprise-ready, dan terinspirasi dari pola UX procurement Precoro tanpa menyalin identitas mereknya."
  primary_color: "Biru profesional; nilai final ditetapkan melalui design system."
  reference: "https://precoro.com/"
  responsive: true
  accessibility: "Gunakan kontras yang memadai, label form yang jelas, navigasi keyboard, focus state, pesan validasi, semantic HTML, serta indikator status yang tidak bergantung pada warna saja."
  layout:
    - "Marketing website menggunakan landing page yang jelas dengan CTA demo atau mulai menggunakan produk."
    - "Aplikasi memakai sidebar navigasi, topbar, breadcrumb, tabel, filter, status badge, dan form terstruktur."
    - "Tabel harus tetap dapat digunakan pada tablet dan mobile."
    - "Gunakan desain yang konsisten untuk status draft, pending, approved, rejected, dan issued."
    - "Tindakan sensitif harus memiliki konfirmasi dan umpan balik yang jelas."
  ui_states:
    - "Loading"
    - "Empty state"
    - "Validation error"
    - "Permission denied"
    - "Success feedback"
    - "Server error"
    - "Disabled action"
    - "Pending approval"
    - "Approval completed"
    - "Rejected with reason"

constraints:
  deadline: "Belum ditentukan; pengerjaan dilakukan bertahap berdasarkan prioritas MVP."
  budget: "Belum ditentukan."
  language: "id"
  compliance:
    - "Terapkan prinsip perlindungan data pribadi yang relevan di Indonesia, termasuk UU Perlindungan Data Pribadi, sesuai penilaian hukum dan operasional."
    - "Terapkan least privilege untuk akses pengguna."
    - "Validasi input dan lakukan otorisasi di sisi server."
    - "Gunakan CSRF protection, output escaping, secure session configuration, dan password hashing."
    - "Jangan menyimpan password dalam bentuk plaintext."
    - "Jangan mempercayai organization_id, role, total harga, atau status yang dikirim browser tanpa validasi server."
    - "Simpan audit trail untuk keputusan approval dan perubahan transaksi penting."
    - "Jangan mengizinkan pengguna mengubah audit log melalui antarmuka normal."
    - "Gunakan database transaction untuk keputusan approval dan penerbitan PO."
    - "Cegah race condition pada approval dan penomoran dokumen melalui locking atau constraint yang tepat."
    - "Terapkan isolasi tenant pada setiap query dan operasi data."
    - "Rahasiakan credential melalui environment variables."
    - "Lakukan backup, pemantauan error, dan pengujian pemulihan sebelum production."
    - "Jangan mengklaim kepatuhan sertifikasi tertentu sebelum audit dan bukti formal tersedia."

security_rules:
  approval_workflow:
    - "Approval wajib dijalankan oleh pengguna yang ditugaskan atau role yang memenuhi aturan workflow aktif."
    - "Dokumen tidak boleh langsung berstatus Approved hanya karena request dikirim."
    - "Setiap keputusan harus memvalidasi status dokumen saat ini, urutan step, aktor, dan tenant."
    - "Dokumen hanya dapat bergerak ke tahap berikutnya setelah seluruh persetujuan wajib pada tahap saat ini selesai."
    - "Penolakan wajib memiliki alasan dan harus menghentikan alur sesuai kebijakan."
    - "Pemohon tidak boleh menyetujui dokumennya sendiri secara default."
    - "Perubahan nominal, item, supplier, atau data material setelah approval harus memicu evaluasi ulang dan approval ulang sesuai kebijakan."
    - "Workflow yang telah dipakai dokumen tidak boleh diubah secara retroaktif tanpa kebijakan migrasi dan audit yang jelas."
    - "Keputusan approval, perubahan status, dan penerbitan PO harus dicatat dalam audit trail."
    - "Gunakan transaksi database dan penguncian yang sesuai untuk mencegah keputusan ganda."
  purchase_order:
    - "PO hanya boleh dibuat dari sumber yang sah atau melalui proses yang secara eksplisit diizinkan."
    - "PO tidak boleh diterbitkan sebelum seluruh approval wajib selesai."
    - "Total PO dihitung ulang di backend dari item, kuantitas, harga, pajak, dan aturan pembulatan."
    - "Nomor PO harus unik dalam organisasi dan aman terhadap request bersamaan."
    - "PO yang sudah diterbitkan tidak boleh diedit secara diam-diam; perubahan harus melalui revisi yang terlacak."
  tenant_isolation:
    - "Setiap model bisnis harus memiliki organization_id secara langsung atau melalui relasi yang tervalidasi."
    - "Semua pencarian berdasarkan ID harus memvalidasi kepemilikan tenant."
    - "Jangan mengandalkan ID acak sebagai pengganti otorisasi."
    - "Uji akses lintas tenant untuk setiap domain utama."

acceptance_criteria:
  - "Pengguna dapat membuat akun, login, dan membuat atau bergabung dengan organisasi."
  - "Pengguna hanya dapat mengakses organisasi yang menjadi anggotanya."
  - "Administrator dapat mengundang anggota dan memberikan role yang sah."
  - "Requester dapat membuat draft Purchase Request dan mengirimkannya untuk approval."
  - "Sistem dapat menentukan workflow berdasarkan aturan yang dikonfigurasi."
  - "Approver hanya dapat memutuskan dokumen yang menjadi kewenangannya dan berada pada tahap yang benar."
  - "Approval oleh pemohon sendiri ditolak secara default."
  - "Approval yang tidak sesuai urutan atau dilakukan dua kali ditolak secara aman."
  - "Penolakan mencatat alasan, aktor, dan waktu."
  - "Perubahan data material setelah approval memicu aturan review atau approval ulang."
  - "Purchase Order tidak dapat diterbitkan jika approval wajib belum selesai."
  - "Nomor PO tetap unik ketika beberapa pengguna membuat dokumen secara bersamaan."
  - "Nilai total Purchase Request dan PO dihitung dan diverifikasi di backend."
  - "Kontrol anggaran yang diaktifkan tidak dapat dilewati hanya dengan mengubah request browser."
  - "Audit trail tersedia untuk keputusan approval dan perubahan dokumen penting."
  - "Tidak ada akses baca atau tulis lintas tenant melalui endpoint, URL, atau manipulasi ID."
  - "Semua halaman memiliki validasi, loading, empty, success, dan error state yang relevan."
  - "Pengujian otomatis mencakup autentikasi, authorization, tenant isolation, approval workflow, budget rules, dan penerbitan PO."
  - "Dokumentasi instalasi, konfigurasi environment, migrasi, seeding, testing, dan deployment tersedia."
  - "Aplikasi dapat dijalankan secara lokal dengan instruksi yang terdokumentasi."
